# ===== Groq (LLM inference API — console.groq.com) =====
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=400
GROQ_TIMEOUT_SECONDS=10

# ===== Mock flags (true = no external calls; flip to false in Week 2) =====
USE_MOCK_LLM=true
USE_MOCK_VECTOR_STORE=true
USE_MOCK_LOGGING=true
USE_MOCK_ANALYTICS=true

# ===== Databases =====
# PSS legacy DB — READ-ONLY role (SELECT-only). Coordinate with PSS BE dev.
PSS_DB_URL=postgresql://readonly_icsa:password@localhost:5432/pss

# ICSA pgvector (Docker, port 5433 to avoid clashing with local PSS on 5432)
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5433/postgres
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PASSWORD=

# ===== Embeddings (local model — Groq is NOT used for embeddings) =====
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ===== CORS (comma-separated list of allowed frontend origins) =====
ALLOWED_ORIGINS=http://localhost:5173